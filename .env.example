# Spreadsheet ID only (the text between /d/ and /edit in its URL)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Email and private key from the Google Cloud service account JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Tab name in the spreadsheet (create this tab and its header row first)
GOOGLE_SHEETS_SHEET_NAME=RSVP
